# Gemeinsame Konfiguration für lokale Entwicklung und Docker Compose.
# Backend und Prisma erzeugen lokal aus den POSTGRES_* Werten automatisch eine
# Verbindung zu localhost. Docker Compose verwendet intern den Host `postgres`.
NODE_ENV=development
PORT=5100

POSTGRES_DB=moebel_design_licensing
POSTGRES_USER=licensing
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

ADMIN_EMAIL=admin@example.invalid
ADMIN_NAME=Lizenz-Administrator
ADMIN_PASSWORD=CHANGE_ME_MINIMUM_16_CHARS

# Derselbe Wert wird in CarpentersProduction als LICENSE_SERVER_API_KEY gesetzt.
CARPENTERS_API_KEY=CHANGE_ME_MINIMUM_32_RANDOM_CHARS
CARPENTERS_CLIENT_NAME=CarpentersProduction

SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=http://licensing.localhost:8088
LICENSING_HOST=licensing.localhost
HTTP_PORT=8088
